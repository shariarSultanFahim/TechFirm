{
  "name": "@repo/api",
  "version": "1.0.0",
  "description": "NestJS + MongoDB + Mongoose backend with RBAC auth and Swagger docs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache"
  },
  "keywords": [
    "nestjs",
    "mongoose",
    "mongodb",
    "auth",
    "rbac",
    "turborepo"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^11.0.10",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.10",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.1",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/swagger": "^11.0.5",
    "@repo/types": "*",
    "@repo/validators": "*",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "mongoose": "^8.12.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
